# 复制到 Nginx 站点配置，例如：
#   sudo cp deploy/nginx.butler.conf.example /etc/nginx/sites-available/butler
#   sudo ln -sf /etc/nginx/sites-available/butler /etc/nginx/sites-enabled/butler
#   sudo nginx -t && sudo systemctl reload nginx
#
# 将 your-domain.com 替换为实际域名或服务器 IP。

upstream butler_backend {
    server 127.0.0.1:3100;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.com;

    # 若已配置 HTTPS，可取消注释以强制跳转
    # return 301 https://$host$request_uri;

    client_max_body_size 32m;

    # 裸机 PM2：直接读取与 Node UPLOADS_DIR 相同的持久化目录
    location /uploads/task/ {
        alias /srv/butler-data/uploads/task/;
        access_log off;
        expires 7d;
    }

    # 上传：流式转发 + 加长超时（配合 Node 多 worker）
    location /api/upload {
        proxy_pass http://butler_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 32m;
    }

    location / {
        proxy_pass http://butler_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

