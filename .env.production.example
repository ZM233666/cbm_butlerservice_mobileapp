# 复制为 .env 后用于生产环境（服务器 / Docker）

NODE_ENV=production
HOST=0.0.0.0
PORT=3100
HTTPS_ENABLED=0

# Docker Compose 宿主机映射端口（可选）
# APP_PORT=3100
# NGINX_HTTP_PORT=80

# 生产环境务必修改（用于本地 JWT 登录 token 签名）
# AUTH_TOKEN_SECRET=请替换为长随机字符串
# AUTH_TOKEN_EXPIRE_SEC=43200

# 远程登录后端（若将来切回工号+密码+验证码登录）
# REMOTE_API_BASE=http://117.62.232.51:8004

# 上传与请求限制
# BODY_LIMIT_MB=2
# MAX_UPLOAD_MB=20

# 逆地理编码（可选）
# REVERSE_GEOCODE_ENABLED=1
# GEOCODE_TIMEOUT_MS=3500
# AMAP_WEB_API_KEY=
