# 复制为 .env 后按需修改

# 服务监听端口（默认 3100）
# PORT=3100

# 监听主机（局域网访问建议 0.0.0.0）
# HOST=0.0.0.0

# 是否启用 HTTPS（1/true/yes 开启）
# HTTPS_ENABLED=0

# HTTPS 证书路径（支持相对项目根目录路径或绝对路径）
# SSL_KEY_PATH=certs/localhost-key.pem
# SSL_CERT_PATH=certs/localhost.pem

# 运行环境（development / production）
# NODE_ENV=development

# 请求体大小上限（MB）
# BODY_LIMIT_MB=2

# 单文件上传上限（MB）
# MAX_UPLOAD_MB=20

# 维修记录数据文件（支持相对项目根目录路径或绝对路径）
# RECORDS_DATA_PATH=server/data/records.json

# 任务定义数据文件（用于统计与汇总接口）
# TASKS_DATA_PATH=public/data/brake-guidance-tasks.json

# 首页卡片配置文件（用于首页任务卡动态渲染）
# HOME_CONFIG_PATH=server/data/home-config.json

# 任务状态文件（todo/doing/done 持久化）
# TASK_STATUS_PATH=server/data/task-status.json

# 是否启用经纬度转地址（逆地理编码）
# REVERSE_GEOCODE_ENABLED=1

# 逆地理编码超时（毫秒）
# GEOCODE_TIMEOUT_MS=3500

# 高德 Web API Key（推荐，国内可解析到市区级）
# AMAP_WEB_API_KEY=
