# 复制为 .env 后用于生产环境（裸机 PM2；Docker Compose 会覆盖容器内路径）

NODE_ENV=production
HOST=0.0.0.0
PORT=3100
HTTPS_ENABLED=0

# Docker Compose 宿主机映射端口（可选）
# APP_PORT=3100
# NGINX_HTTP_PORT=80

# 上传并发：默认 8 个 Node worker（约 8 路并行 /api/upload）
# 建议：任务图挂载共享目录（TASK_UPLOADS_HOST_DIR → /data/uploads/task）；8 核机可保持 8，4 核可改为 4–6
# 单进程调试：NODE_CLUSTER_ENABLED=0
NODE_CLUSTER_WORKERS=8
NODE_CLUSTER_ENABLED=1

# 裸机 PM2 持久化目录；Docker Compose 会覆盖为 /data/uploads/task
UPLOADS_DIR=/srv/butler-data/uploads/task
# Docker Compose 宿主机挂载目录（容器内仍为 /data/uploads/task）
TASK_UPLOADS_HOST_DIR=/srv/butler-data/uploads/task
MAX_UPLOAD_MB=30

# HTTPS（Docker profile with-nginx-ssl）
# NGINX_HTTPS_PORT=443
# SSL_CERT_PATH=./certs/fullchain.pem
# SSL_KEY_PATH=./certs/privkey.pem

# 生产环境务必修改（若偶发开启本地烟测 token）
# AUTH_TOKEN_SECRET=请替换为长随机字符串
# AUTH_TOKEN_EXPIRE_SEC=43200

# 远程 Django（正式登录/用户信息）
# 同机 Docker：后端 init.sh 后 Django 映射宿主机 8004
REMOTE_API_BASE=http://host.docker.internal:8004
TASK_DATA_SOURCE=db

# Node 调用 Django 的超时：读取 30 秒，写入 90 秒
UPSTREAM_READ_TIMEOUT_MS=30000
UPSTREAM_WRITE_TIMEOUT_MS=90000

# REMOTE_PROXY_PREFIXES=/captcha/,/login/,/system/,/token/

# 生产默认关闭本地 HMAC；仅烟测/应急时可临时打开
ALLOW_LOCAL_AUTH=0

# 上传与请求限制（与前端 / Django 30MB、Nginx 32m 对齐）
# BODY_LIMIT_MB=2
# MAX_UPLOAD_MB=30

# 上传性能：客户端已带 GPS 时跳过服务端 EXIF；逆地理编码异步写 manifest
# UPLOAD_SKIP_SERVER_EXIF=1
# UPLOAD_GEOCODE_ASYNC=1
# REVERSE_GEOCODE_ENABLED=0

# Node BFF 读接口短缓存（毫秒），写操作会自动失效
# API_CACHE_HOME_CONFIG_MS=30000
# API_CACHE_TASK_STATUS_MS=15000
# API_CACHE_USER_PROFILE_MS=300000
# API_CACHE_MANAGER_DASHBOARD_MS=60000
# API_CACHE_TASK_CENTRE_MS=30000

# 逆地理编码（可选，高峰建议关闭或保持异步）
# REVERSE_GEOCODE_ENABLED=1
# GEOCODE_TIMEOUT_MS=3500
# AMAP_WEB_API_KEY=
