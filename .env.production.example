# 复制为 .env 后用于生产环境（服务器 / Docker）

NODE_ENV=production
HOST=0.0.0.0
PORT=3100
HTTPS_ENABLED=0

# Docker Compose 宿主机映射端口（可选）
# APP_PORT=3100
# NGINX_HTTP_PORT=80

# 生产环境务必修改（若偶发开启本地烟测 token）
# AUTH_TOKEN_SECRET=请替换为长随机字符串
# AUTH_TOKEN_EXPIRE_SEC=43200

# 远程 Django（正式登录/用户信息）
REMOTE_API_BASE=http://117.62.232.51:8004
# REMOTE_PROXY_PREFIXES=/captcha/,/login/,/system/,/token/

# 生产默认关闭本地 HMAC；仅烟测/应急时可临时打开
ALLOW_LOCAL_AUTH=0

# 上传与请求限制
# BODY_LIMIT_MB=2
# MAX_UPLOAD_MB=20

# 逆地理编码（可选）
# REVERSE_GEOCODE_ENABLED=1
# GEOCODE_TIMEOUT_MS=3500
# AMAP_WEB_API_KEY=
