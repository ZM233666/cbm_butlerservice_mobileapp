{
  "name": "butler-service",
  "version": "1.0.0",
  "private": true,
  "description": "ButlerService — 后端服务",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "start:lan": "HOST=0.0.0.0 node server/server.js",
    "start:https": "HTTPS_ENABLED=1 HOST=0.0.0.0 node server/server.js",
    "frontend:build": "npm run build --prefix frontend",
    "start:vue": "npm run frontend:build && node server/server.js",
    "start:prod": "NODE_ENV=production node server/server.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:docker": "bash scripts/docker-deploy.sh",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f butler",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "dev": "node --watch server/server.js",
    "dev:db": "node --watch server/server.js",
    "dev:local-db": "bash scripts/dev-local-db.sh",
    "validate:data": "node scripts/validate-data.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run validate:data && npm test",
    "test:api": "node scripts/api-smoke.js",
    "test:webapp": "bash ./run_webapp_smoke.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  }
}
