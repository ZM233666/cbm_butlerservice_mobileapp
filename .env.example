# 复制为 .env 后按需修改

# 服务监听端口（默认 3100）
# PORT=3100

# 监听主机（局域网访问建议 0.0.0.0）
# HOST=0.0.0.0

# 是否启用 HTTPS（1/true/yes 开启）
# HTTPS_ENABLED=0

# HTTPS 证书路径（支持相对项目根目录路径或绝对路径）
# SSL_KEY_PATH=certs/localhost-key.pem
# SSL_CERT_PATH=certs/localhost.pem

# 运行环境（development / production）
# NODE_ENV=development

# 请求体大小上限（MB）
# BODY_LIMIT_MB=2

# 单文件上传上限（MB）；与前端 / Django 对齐为 30
# MAX_UPLOAD_MB=30

# 任务图片目录（对外 URL 仍为 /uploads/task/<文件名>）
# 本地默认：../butler-service/backend/media/uploads/task
# Docker：UPLOADS_DIR=/data/uploads/task
# UPLOADS_DIR=../butler-service/backend/media/uploads/task

# 任务数据源：默认 db（Django PostgreSQL）。仅保留 json 用于显式回退调试。
# TASK_DATA_SOURCE=db

# 是否启用经纬度转地址（逆地理编码）
# REVERSE_GEOCODE_ENABLED=1

# 逆地理编码超时（毫秒）
# GEOCODE_TIMEOUT_MS=3500

# 高德 Web API Key（推荐，国内可解析到市区级）
# AMAP_WEB_API_KEY=

# =================================================
# Django 登录 / 任务 API
# =================================================
# 本地联调（先启动 butler-service/backend：./dev-api.sh → :8005，连 env.py 远程 dev 库）
# 勿用 Cursor 转发的 :8004（多为 docker 旧库，任务会与 pg 不一致）
REMOTE_API_BASE=http://127.0.0.1:8005
# Node 调用 Django 的超时：读取 30 秒，写入 90 秒
# UPSTREAM_READ_TIMEOUT_MS=30000
# UPSTREAM_WRITE_TIMEOUT_MS=90000
# TASK_DATA_SOURCE=db
# SKIP_REMOTE_AUTH=0
#
# 远程环境
# REMOTE_API_BASE=http://117.62.232.51:8004

# 需要转发到远程 Django 的 /api 路径前缀（逗号分隔）
# REMOTE_PROXY_PREFIXES=/captcha/,/login/,/system/,/token/

# 是否允许 Node 本地 HMAC token（烟测/开发）。生产建议关闭。
# 未设置时：非 production 默认开启；production 默认关闭
# ALLOW_LOCAL_AUTH=1

# 开发期临时跳过远程 Django 鉴权（远端 DB 连接池打满时可开）
# SKIP_REMOTE_AUTH=1

# Django user_info 鉴权短缓存（毫秒，默认 5 分钟）
# AUTH_CACHE_TTL_MS=300000

# 认证上游（Django user_info）全局并发目标
# Cluster 模式：由 primary 跨 worker 全局限流/同 Token 合并/共享熔断（IPC 不传明文 JWT）
# 单进程模式：本进程内限流；额度即 AUTH_UPSTREAM_MAX_CONCURRENCY
# AUTH_UPSTREAM_MAX_CONCURRENCY=16
# AUTH_UPSTREAM_QUEUE_MAX=64
# AUTH_UPSTREAM_QUEUE_WAIT_MS=3000

# 生产多 worker（npm start / cluster.js；PM2 请用 ecosystem 的 cluster.js fork，勿对 server.js 开 PM2 cluster）
# NODE_CLUSTER_WORKERS=8
# NODE_CLUSTER_ENABLED=1

# 作业指导书模板（task-summary 统计用，非业务任务数据）
# TASKS_DATA_PATH=public/data/brake-guidance-tasks.json

# 本地 token 签名密钥（仅 ALLOW_LOCAL_AUTH=1 时使用）
# AUTH_TOKEN_SECRET=butler-dev-secret
# AUTH_TOKEN_EXPIRE_SEC=43200
